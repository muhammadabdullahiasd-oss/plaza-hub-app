# Local development only. Copy to .env; never commit the resulting file.
# No NEXT_PUBLIC_ database URL or production credentials.
DATABASE_URL="postgresql://plazahub:plazahub_local_only@127.0.0.1:5432/plazahub_dev"
# Used by optional local Docker Compose. Match DATABASE_URL if changed.
POSTGRES_USER=plazahub
POSTGRES_PASSWORD=plazahub_local_only
POSTGRES_DB=plazahub_dev

# Task 005: opt-in LOCAL DEVELOPMENT ONLY. Auth is closed in production builds.
PLAZAHUB_AUTH_MODE=disabled
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a random secret with at least 32 bytes; no default is supplied.
BETTER_AUTH_SECRET=
# No mail/SMS provider is approved. Signup, invitations and recovery are disabled.
# Integration tests require an explicitly confirmed, separate loopback database:
# PLAZAHUB_TEST_DATABASE_URL= (database name must end in _test)
# PLAZAHUB_TEST_DB_CONFIRMED=YES
