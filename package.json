{
  "name": "plazahub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "pnpm db:generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm db:generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:foundation": "node --test tests/foundation/*.test.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check": "tsx scripts/check-db.ts",
    "check": "pnpm db:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm test:foundation && pnpm build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.22",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.2.3",
    "better-auth": "1.7.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "next": "16.4.5",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^27.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
